# Supabase (server-side only — service role key bypasses RLS, never expose to the client)
SUPABASE_URL=https://hicwhrywdfeefpagjnta.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Hospitable Public API v2
HOSPITABLE_API_BASE_URL=https://public.api.hospitable.com/v2
HOSPITABLE_API_KEY=

# Guest network authorization — a Home Assistant webhook, not UniFi directly.
# A UniFi Site Manager API key cannot grant guest access (confirmed live:
# the unifi.ui.com proxy is GET-only, no write path exists). See lib/unifi.ts.
HOME_ASSISTANT_WEBHOOK_URL=
HOME_ASSISTANT_WEBHOOK_SECRET=

# Admin lookup page (/admin) — HTTP Basic Auth
ADMIN_USERNAME=
ADMIN_PASSWORD=
